# AWS EOL Monitor — default environment
#
# ── LOCAL DEV (laptop / EC2 direct) ─────────────────────────────────────────
#   Leave REACT_APP_API_URL empty.
#   CRA dev server proxies /eol/* and /workspaces/* → localhost:3001.
#   Start backend separately:  python3 scripts/run-local-backend.py
#
# ── PRODUCTION BUILD behind Nginx ───────────────────────────────────────────
#   Set REACT_APP_API_URL=/api at build time (relative URL, same origin).
#   Nginx must proxy  /api/ → http://localhost:3001/
#
#   Example nginx.conf snippet:
#     location /api/ {
#         proxy_pass http://localhost:3001/;
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     }
#
#   With this setup no CORS headers are needed (same-origin).
#   Backend ALLOWED_ORIGIN env var can remain "*" or your domain:
#     ALLOWED_ORIGIN=https://yourdomain.com
#
# ── PRODUCTION BUILD with API Gateway ───────────────────────────────────────
#   Set REACT_APP_API_URL to your API Gateway invoke URL at build time:
#   REACT_APP_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
#   Set backend ALLOWED_ORIGIN=https://yourdomain.com
#
# ── Demo workspace ───────────────────────────────────────────────────────────
#   REACT_APP_ENABLE_DEMO_DATA=true  → compile-time demo (all users see mock data)
#   Demo workspace button on Overview sets ws_demo at runtime (per-user, no build needed)

REACT_APP_API_URL=/api
REACT_APP_ENABLE_DEMO_DATA=false

# Set to "true" to enable Organization Scan (StackSet/org-wide flow).
# Default is "false" — shows Coming Soon in sidebar and at /org-scan.
REACT_APP_ORG_SCAN_ENABLED=true

# Allow admin console login over insecure HTTP (non-localhost).
# true  → login allowed over HTTP; shows amber dev warning. Use for internal HTTP testing only.
# false → login blocked over HTTP; red warning shown. Always use false in production.
# Default: false (secure).
REACT_APP_ALLOW_INSECURE_ADMIN=false
