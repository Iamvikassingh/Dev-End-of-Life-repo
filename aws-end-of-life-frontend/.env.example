# ─────────────────────────────────────────────────────────────────
# AWS EOL Monitor — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────────

# Enable Organization Scan (default: false = Coming Soon)
# Set to "true" when StackSet/org-wide flow is ready.
REACT_APP_ORG_SCAN_ENABLED=false

# Feature flags. Keep private-beta/incomplete features hidden unless enabled.
REACT_APP_ENABLE_ORG_SCAN=false
REACT_APP_ENABLE_REMEDIATION=false
REACT_APP_ENABLE_SSO=false
REACT_APP_ENABLE_BILLING=false
REACT_APP_ENABLE_CICD_SCAN=false

# Allow admin console login over insecure HTTP (non-localhost).
# true  → login allowed over HTTP with amber dev warning. For internal HTTP testing only.
# false → login blocked over HTTP with red warning. Always keep false in production.
REACT_APP_ALLOW_INSECURE_ADMIN=false

# API Gateway base URL (no trailing slash)
# For local dev with scripts/local-api.py, use http://localhost:3001
# For AWS deployment, use your API Gateway invoke URL:
#   https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
REACT_APP_API_URL=http://localhost:3001

# ── Cognito Auth (optional — leave blank to disable authentication) ──
# User Pool ID  (e.g. us-east-1_AbCdEfGhI)
REACT_APP_COGNITO_USER_POOL_ID=

# App Client ID  (e.g. 2abc3defgh4ijklmnopqrs5tuv)
REACT_APP_COGNITO_CLIENT_ID=

# Cognito region  (must match the User Pool region)
REACT_APP_COGNITO_REGION=us-east-1
