# ─────────────────────────────────────────────────────────────────────────────
# AWS EOL Monitor — Frontend .gitignore
# React (Create React App) + Node.js
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Production build ──────────────────────────────────────────────────────────
build/
dist/

# ── Environment variables ─────────────────────────────────────────────────────
# .env.example        → COMMIT   (safe template, no secrets)
# .env                → COMMIT   (safe defaults, no secrets)
# .env.local          → IGNORE   (local overrides, may contain real API URLs)
# .env.local.example  → COMMIT   (setup guide)
# .env.*.local        → IGNORE   (all local env files)
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ── Test output ───────────────────────────────────────────────────────────────
coverage/
lcov.info

# ── CRA / tooling cache ───────────────────────────────────────────────────────
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Storybook ─────────────────────────────────────────────────────────────────
storybook-static/

# ── Misc ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
