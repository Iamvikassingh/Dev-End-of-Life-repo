# ─────────────────────────────────────────────────────────────────────────────
# AWS EOL Monitor — Local frontend environment
# Copy to .env.local (git-ignored). This file overrides .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A: Real backend (recommended) ─────────────────────────────────────
# Run the backend first:  make backend
# Then start the frontend: make dev-frontend
REACT_APP_API_URL=http://localhost:3001
REACT_APP_ENABLE_DEMO_DATA=false
REACT_APP_ENABLE_ORG_SCAN=false
REACT_APP_ENABLE_REMEDIATION=false
REACT_APP_ENABLE_SSO=false
REACT_APP_ENABLE_BILLING=false
REACT_APP_ENABLE_CICD_SCAN=false

# ── Option B: Demo/mock data only (no backend needed) ────────────────────────
# Useful for quick UI review without running any server.
# REACT_APP_API_URL=
# REACT_APP_ENABLE_DEMO_DATA=true

# ── Production ────────────────────────────────────────────────────────────────
# Set REACT_APP_API_URL to your API Gateway invoke URL at build time.
# REACT_APP_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
# REACT_APP_ENABLE_DEMO_DATA=false
