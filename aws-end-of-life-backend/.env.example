# ─────────────────────────────────────────────────────────────────────────────
# AWS EOL Monitor — Backend Environment Variables
# Copy to backend/.env and fill in values, OR export in your shell before
# running scripts. In Lambda, set these via --environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage backend ───────────────────────────────────────────────────────────
# Choose where scan results and config are persisted:
#   postgres  — PostgreSQL database (recommended for production on EC2)
#   file      — local JSON files on disk, NO AWS credentials needed (best for local dev)
#   dynamodb  — AWS DynamoDB tables (default in Lambda)
#   s3        — single JSON file per data type in an S3 bucket
STORAGE_BACKEND=file

# ── PostgreSQL settings (used when STORAGE_BACKEND=postgres) ─────────────────
# Replace <password> with the actual database password.
# NEVER commit a real password — keep this in backend/.env (not tracked by git).
#
# Setup:   python3 backend/scripts/setup_postgres.py
# Migrate: python3 backend/scripts/migrate_file_to_postgres.py --data-dir /home/ubuntu/eol-data
#
# For production, use a dedicated low-privilege user (not postgres superuser):
#   CREATE USER eol_app WITH PASSWORD 'strong_password_here';
#   GRANT ALL PRIVILEGES ON DATABASE eol_monitor TO eol_app;
#   GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO eol_app;
#   GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO eol_app;
#
DATABASE_URL=postgresql://eol_app:<password>@localhost:5432/eol_monitor

# File backend settings (used when STORAGE_BACKEND=file)
EOL_DATA_DIR=/tmp/eol-data

# DynamoDB settings (used when STORAGE_BACKEND=dynamodb)
DYNAMODB_TABLE=aws-eol-inventory
CONFIG_TABLE=aws-eol-config
DEDUP_TABLE=aws-eol-alert-dedup

# S3 settings (used when STORAGE_BACKEND=s3)
# EOL_BUCKET=my-eol-monitor-bucket

# ── General EOL Library ───────────────────────────────────────────────────────
# TTL (hours) for lifecycle data cached from endoflife.date.
# After expiry the next GET /eol/general refreshes automatically.
GENERAL_EOL_CACHE_TTL_HOURS=24

# Override the endoflife.date API base (useful for offline/test environments)
# EOL_API_BASE=https://endoflife.date/api

# ── Alert / scan settings ─────────────────────────────────────────────────────
# Days before EOL to classify a resource as EXPIRING_SOON
WARN_DAYS=180

# SNS topic ARN for EOL/expiring-soon alerts (leave empty to disable)
SNS_TOPIC_ARN=

# Minimum hours before the same resource triggers another alert
DEDUP_HOURS=24

# ── Lambda settings ───────────────────────────────────────────────────────────
# Name of the collector Lambda (api_handler uses this for manual scan triggers)
COLLECTOR_FUNCTION=aws-eol-collector

# ── Local development ─────────────────────────────────────────────────────────
# AWS region (Lambda reads from its execution environment automatically)
AWS_DEFAULT_REGION=us-east-1

# Named AWS profile for local runs (blank = default profile or instance role)
# AWS_PROFILE=my-dev-profile

# Port for scripts/run-local-backend.py
PORT=3001

# ── Environment mode ─────────────────────────────────────────────────────────
# Set to "production" on your live server. When APP_ENV=production:
#   - ALLOWED_ORIGIN=* causes a startup failure (fatal error, not a warning).
#   - MEMBER_LOGIN_DEV_LINKS=true causes a startup failure.
# Leave as "development" for local/dev environments.
APP_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION: Set to your exact frontend origin (no trailing slash).
# Defaults to "*" which allows all origins — FATAL in production (see APP_ENV above).
# Example: ALLOWED_ORIGIN=https://eolmonitor.example.com
ALLOWED_ORIGIN=*

# ── Public app URL / member magic login ───────────────────────────────────────
# Base URL used to build member magic-login links.
# Local dev: APP_PUBLIC_URL=http://localhost:3000
# EC2 HTTP dev: APP_PUBLIC_URL=http://18.190.167.18
# Production: APP_PUBLIC_URL=https://yourdomain.com
APP_PUBLIC_URL=http://localhost:3000

# WARNING: Keep false in production. When true and email is not configured,
# backend logs/API responses may include raw one-time member login links.
MEMBER_LOGIN_DEV_LINKS=false

# ── Organization Scan settings ───────────────────────────────────────────────
# IAM role name deployed in each member account for org scan. Must match the
# role name in member-account-role.json and eol-collector-policy.json.
ORG_MEMBER_ROLE_NAME=EOLMonitorReadOnly

# ── Feature flags ─────────────────────────────────────────────────────────────
# Keep incomplete/private-beta features disabled in production unless explicitly enabled.
ENABLE_ORG_SCAN=false
ENABLE_REMEDIATION=false
ENABLE_SSO=false
ENABLE_BILLING=false
ENABLE_CICD_SCAN=false

# ── Admin portal ──────────────────────────────────────────────────────────────
# Secret token for /internal-admin access. Keep this private.
# If left empty, admin API endpoints are disabled entirely.
# Generate a strong value: python3 -c "import secrets; print('eolm_admin_'+secrets.token_hex(24))"
ADMIN_PORTAL_TOKEN=
