STORAGE_BACKEND=postgres
DATABASE_URL="postgresql://eol_app:PasswordStrong123@10.0.0.22:5432/eol_monitor"
EOL_DATA_DIR=/home/ubuntu/eol-data
ALLOWED_ORIGIN=https://eol.vikassingh.site
GENERAL_EOL_CACHE_TTL_HOURS=24
ADMIN_PORTAL_TOKEN=eolm_admin_c64dbf677c85bb4dd3ee1c9c6331573c535bf8aa038ca685
PYTHONPATH=/home/ubuntu/aws-end-of-life-backend
PORT=3001
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
LIFECYCLE_DISCOVERY_ENABLED=true
APP_PUBLIC_URL=https://eol.vikassingh.site
APP_ENV=production
MEMBER_LOGIN_DEV_LINKS=false
ENABLE_ORG_SCAN=true
ENABLE_REMEDIATION=false
ENABLE_SSO=false
ENABLE_BILLING=false
ENABLE_CICD_SCAN=false

# ── Rate limiting (in-memory, resets on restart) ──────────────────────────────
WORKSPACE_CREATE_RATE_LIMIT=3
WORKSPACE_CREATE_RATE_WINDOW_SECONDS=3600
WORKSPACE_AUTH_FAIL_LIMIT=20
WORKSPACE_AUTH_FAIL_WINDOW_SECONDS=900

# ── Auth feature flags (all false by default — current workspace token flow unchanged) ──
AUTH_EMAIL_SIGNUP_ENABLED=false
AUTH_GOOGLE_SIGNUP_ENABLED=false
AUTH_CAPTCHA_ENABLED=false
AUTH_EMAIL_VERIFICATION_REQUIRED=false
AUTH_SESSION_COOKIE_ENABLED=true
ANONYMOUS_WORKSPACE_CREATE_ENABLED=true

# ── Google OAuth (fill in when AUTH_GOOGLE_SIGNUP_ENABLED=true) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── CAPTCHA (fill in when AUTH_CAPTCHA_ENABLED=true) ─────────────────────────
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ── Session / email verification ──────────────────────────────────────────────
SESSION_TTL_HOURS=12
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30

# ── SSO / SAML (all false by default — enable when IdP is configured) ─────────
# SAML_RELAY_SIGNING_KEY must be set to a stable secret so PM2 restarts don't
# break in-flight SAML logins. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SAML_RELAY_SIGNING_KEY=
AUTH_SAML_ENABLED=false
AUTH_SAML_AUTO_PROVISION_USERS=false
AUTH_SAML_REQUIRE_VERIFIED_EMAIL=true

# SP (Service Provider) URLs — must match your deployment domain
SAML_ENTITY_ID=https://eol.vikassingh.site/auth/saml/metadata
SAML_ACS_URL=https://eol.vikassingh.site/auth/saml/acs
SAML_SLO_URL=https://eol.vikassingh.site/auth/saml/logout

# IdP (Identity Provider) config — fill in from your IdP metadata
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_SLO_URL=
SAML_IDP_X509_CERT=

# Access control
SAML_DEFAULT_WORKSPACE_ROLE=viewer
SAML_ALLOWED_DOMAINS=

# Attribute mapping (adjust if your IdP uses different attribute names)
SAML_ATTRIBUTE_EMAIL=email
SAML_ATTRIBUTE_NAME=name
SAML_ATTRIBUTE_FIRST_NAME=firstName
SAML_ATTRIBUTE_LAST_NAME=lastName
SAML_ATTRIBUTE_GROUPS=groups

# Group-to-role mapping (comma-separated group names; highest role wins: owner > editor > viewer)
# Example: SAML_GROUP_OWNER=EOLMonitorAdmins,CloudAdmins
SAML_GROUP_OWNER=
SAML_GROUP_EDITOR=
SAML_GROUP_VIEWER=

# Rate limits for SAML endpoints
SAML_LOGIN_RATE_LIMIT=20
SAML_LOGIN_RATE_WINDOW=3600
SAML_ACS_RATE_LIMIT=20
SAML_ACS_RATE_WINDOW=3600

# ── Notifications ─────────────────────────────────────────────────────────────
# Email provider: ses (AWS SES, default) | smtp (generic SMTP)
NOTIFICATIONS_EMAIL_PROVIDER=ses

# From address — must be verified in SES console (or valid SMTP sender)
NOTIFICATIONS_FROM_EMAIL=noreply@eol.vikassingh.site

# Frontend URL included as a link in email/Slack notifications
APP_URL=https://eol.vikassingh.site

# ── SMTP (fill in only if NOTIFICATIONS_EMAIL_PROVIDER=smtp) ──────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@eol.vikassingh.site
